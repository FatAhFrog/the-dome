+      {owned ? (
+        <span style={{ fontSize: '0.8rem', color: '#3ddc84', fontWeight: 600 }}>Owned ✓</span>
+      ) : maxed ? (
+        <span style={{ fontSize: '0.8rem', color: '#999', fontWeight: 600 }}>Maxed out</span>
+      ) : (
+        <button
+          onClick={onBuy}
+          disabled={disabled || busy}
+          style={{
+            padding: '0.35rem 0.75rem',
+            background: disabled || busy ? '#ccc' : 'var(--color-accent)',
+            color: '#fff',
+            border: 'none',
+            borderRadius: '6px',
+            cursor: disabled || busy ? 'not-allowed' : 'pointer',
+            fontSize: '0.8rem',
+          }}
+        >
+          {busy ? 'Buying...' : `${buyLabel} — 🪙 ${price?.toLocaleString()}`}
+        </button>
+      )}
+    </div>
+  )
+}
