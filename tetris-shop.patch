+    setNamingTheme(key)
+    setThemeName(THEMES[key].label)
+  }
+
+  const confirmThemePurchase = () => {
+    if (!namingTheme) return
+    const name = themeName.trim() || THEMES[namingTheme].label
+    onBuyTheme(namingTheme, name)
