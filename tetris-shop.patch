+      <p style={{ marginTop: '1rem', color: '#999', fontSize: '0.9rem', textAlign: 'center' }}>
         ← → move · ↓ soft drop · ↑ rotate · Space hard drop · P pause
+        {upgrades.hold && <> · / hold</>}
       </p>
+
+      <ShopPanel
+        open={shopOpen}
+        onClose={() => setShopOpen(false)}
+        coins={coins}
+        upgrades={upgrades}
+        ownedThemeKeys={ownedThemeKeys}
+        busyKey={busyKey}
+        onBuyUpgrade={buyUpgrade}
+        onBuyTheme={buyTheme}
+      />
     </main>
