--- /dev/null
+++ b/supabase/migrations/003_coin_rpcs.sql
@@ -0,0 +1,56 @@
+-- Atomic coin earn/spend. The frontend was trusting local React state and
+-- writing it back via a reactive effect, which gave zero signal on failure
+-- and no guarantee the write actually matched the server's truth. These
+-- functions do the mutation AND return the authoritative new balance in
+-- one round trip, so the client can verify every single earn and spend
+-- against the database instead of assuming its local number is right.
+--
+-- auth.uid() is used instead of a passed-in user id so a user can only
+-- ever earn/spend coins on their own row.
+
+create or replace function public.earn_coins(p_amount integer)
+returns integer
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  new_balance integer;
+begin
+  if p_amount <= 0 then
+    raise exception 'amount must be positive';
+  end if;
+
+  update public.profiles
+  set coins = coins + p_amount
+  where id = auth.uid()
+  returning coins into new_balance;
+
+  return new_balance; -- null if no matching row (shouldn't happen for a signed-in user)
+end;
+$$;
+
+create or replace function public.spend_coins(p_amount integer)
+returns integer
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  new_balance integer;
+begin
+  if p_amount <= 0 then
+    raise exception 'amount must be positive';
+  end if;
+
+  update public.profiles
+  set coins = coins - p_amount
+  where id = auth.uid() and coins >= p_amount
+  returning coins into new_balance;
+
+  return new_balance; -- null => insufficient funds (or no row), caller must treat as failure
+end;
+$$;
+
+grant execute on function public.earn_coins(integer) to authenticated;
+grant execute on function public.spend_coins(integer) to authenticated;
