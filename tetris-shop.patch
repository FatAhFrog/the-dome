@@ -0,0 +1,99 @@
+// Palette definitions for the Dome's purchasable themes.
+// 'dome' is the free default and is never bought/owned via theme_purchases.
+// Everything else costs THEME_PRICE coins in the Tetris shop and, once
+// owned, can be activated from the Profile page.
+
+export type ThemeKey = 'dome' | 'sunset_lagoon' | 'neon_arcade' | 'pastel_dream' | 'crimson_void'
+
+export type ThemeDefinition = {
+  key: ThemeKey
+  label: string
+  description: string
+  accent: string
+  accentSecondary: string
+  background: string
+  text: string
+  onAccent: string
+  price: number | null // null = not purchasable (the default theme)
+}
+
+export const THEME_PRICE = 1000
+
+export const THEMES: Record<ThemeKey, ThemeDefinition> = {
+  dome: {
+    key: 'dome',
+    label: 'Classic Dome',
+    description: 'The original orange-on-white look.',
+    accent: '#EB4600',
