diff --git a/components/ThemeLoader.tsx b/components/ThemeLoader.tsx
new file mode 100644
index 0000000..ad80860
--- /dev/null
+++ b/components/ThemeLoader.tsx
@@ -0,0 +1,33 @@
+'use client'
+
+import { useEffect } from 'react'
+import { createClient } from '@/lib/supabase/client'
+import { applyThemeVars } from '@/lib/themes'
+
+// Applies the signed-in user's active Dome theme as CSS vars on <html>
+// as soon as any (dome) page mounts, so the purchased palette re-skins
+// the whole app (side panel, buttons, etc.), not just Tetris.
+export default function ThemeLoader() {
+  useEffect(() => {
+    const supabase = createClient()
+    let cancelled = false
+
+    const load = async () => {
+      const { data: { user } } = await supabase.auth.getUser()
+      if (!user || cancelled) return
+      const { data: profile } = await supabase
+        .from('profiles')
+        .select('active_theme')
+        .eq('id', user.id)
+        .single()
+      if (!cancelled) applyThemeVars(profile?.active_theme)
+    }
+
+    load()
+    return () => {
+      cancelled = true
+    }
+  }, [])
+
+  return null
+}
